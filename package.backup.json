{
  "name": "primus-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Primus IDE core scaffold with Spec-Kit driven workflow (Electron + React + TypeScript)",
  "author": "Primus Contributors",
  "repository": {
    "type": "git",
    "url": "https://example.com/primus/primus-ide.git"
  },
  "type": "commonjs",
  "main": "dist/main/main/main.js",
  "scripts": {
    "spec:plan": "node scripts/spec-kit/generate-plan.cjs specs/*.spec.md",
    "spec:tasks": "node scripts/spec-kit/generate-tasks.cjs plans/*.plan.json",
    "spec:all": "npm run spec:plan && npm run spec:tasks",
    "hello": "node src/hello-cli.js",
    "test": "jest --runInBand",
    "test:commands": "node --loader ts-node/esm test/commandPalette.test.ts",
    "build:test:commands": "tsc -p tsconfig.tests.json",
    "run:test:commands": "node dist-tests/test/commandPalette.test.js",
    "test:security": "node test/secretScanner.test.js",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:main": "tsc -p tsconfig.main.json && node scripts/ensure-main-cjs.cjs",
    "build:renderer": "webpack --config webpack.renderer.prod.js",
    "build": "npm run build:preload && npm run build:main && npm run build:renderer && node scripts/copy-ai-policy.cjs",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "webpack serve --config webpack.renderer.dev.js",
    "dev:electron": "wait-on dist/main/main/main.js tcp:3001 && cross-env NODE_ENV=development electronmon dist/main/main/main.js",
    "dev": "concurrently \"npm:dev:*\"",
    "start": "cross-env NODE_ENV=production electron dist/main/main/main.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder -w",
    "release": "npm run build && electron-builder -w",
    "generate:tasks": "node scripts/automation/generateTasksJson.cjs",
    "snapshot:tasks": "node scripts/automation/generateTasksJson.cjs --snapshot",
    "diff:tasks": "node scripts/automation/diffTasks.cjs",
    "enrich:tasks": "node scripts/automation/enrichTasks.cjs",
    "score:tasks": "node scripts/automation/scoreTasks.cjs",
    "export:gherkin": "node scripts/automation/exportGherkin.cjs",
    "trace:tasks": "node scripts/automation/generateTraceMap.cjs",
    "guard:tasks": "node scripts/automation/guardTasks.cjs --strict",
    "tasks:pipeline": "node scripts/automation/tasksPipeline.cjs",
    "task:next": "node scripts/automation/nextTask.cjs",
    "task:start": "node scripts/automation/workTask.cjs start",
    "task:complete": "node scripts/automation/workTask.cjs complete",
    "task:reset": "node scripts/automation/workTask.cjs reset",
    "tasks:queue": "node scripts/automation/generateTaskQueue.cjs",
    "tasks:batch": "node scripts/automation/nextBatch.cjs",
    "tasks:status": "node scripts/automation/tasksStatusSummary.cjs",
    "tasks:kpi": "node scripts/automation/tasksKpiDashboard.cjs",
    "tasks:board": "node scripts/automation/tasksStatusBoard.cjs",
    "tasks:board:watch": "node scripts/automation/tasksStatusBoardWatch.cjs",
    "tasks:board:serve": "node scripts/automation/serveArtifacts.cjs",
    "tasks:autopilot": "node scripts/automation/autopilot.cjs --dry-run --iterations=1",
    "tasks:context": "node scripts/automation/buildContextBundle.cjs --from-batch",
    "tasks:semantic-diff": "node scripts/automation/semanticDiffStub.cjs",
    "tasks:verify": "node scripts/automation/runVerifier.cjs",
    "tasks:semantic-symbol": "node scripts/automation/semanticSymbolDiff.cjs",
    "verify:pack": "node scripts/verify-pack.cjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@types/diff": "^7.0.2",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "axios": "^1.11.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "electron": "^38.1.2",
    "electron-updater": "^6.1.8",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.53.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.2.0",
    "simple-git": "^3.28.0",
    "tailwind-merge": "^3.3.1",
    "vscode-debugadapter": "^1.51.0"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/vscode": "^1.103.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.2",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.primus.ide",
    "productName": "PrimusIDE",
    "icon": "build-resources/icon.ico",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/preload/**/*",
      "package.json",
      "LICENSE*",
      "README.md",
      "ai.policy.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/downloads/"
      }
    ]
  }
}